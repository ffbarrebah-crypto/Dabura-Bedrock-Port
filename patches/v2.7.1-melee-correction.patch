+ // Native player melee hits are the direct combat input while embodied as Dabura.
+ // Trigger the short jab (or the heavier cross when the jab is cooling down) so a player
+ // does not have to open the technique menu for every close-range punch.
+ const meleeInputAt = new Map();
+ world.afterEvents.entityHitEntity.subscribe((ev) => {
+   const p = ev.damagingEntity;
+   if (!p || !isPlayer(p) || !inForm(p) || !valid(ev.hitEntity)) return;
+   const t = now(), last = meleeInputAt.get(p.id) || -1000;
+   if (t - last < 8 || casts.has(p.id)) return;
+   const id = !checkMeleeCooldown(p, 13) ? 13 : 14;
+   meleeInputAt.set(p.id, t);
+   playerCast(p, id);
+ });
